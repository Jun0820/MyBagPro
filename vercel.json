{
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/settings/pros",
      "status": 301,
      "headers": {
        "Location": "/pros"
      }
    },
    {
      "src": "/settings/pros/(.*)",
      "status": 301,
      "headers": {
        "Location": "/pros/$1"
      }
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "mybagpro.jp"
        }
      ],
      "dest": "/mybagpro.html"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "www.mybagpro.jp"
        }
      ],
      "dest": "/mybagpro.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "mybagpro.jp"
        }
      ],
      "dest": "/mybagpro.html"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.mybagpro.jp"
        }
      ],
      "dest": "/mybagpro.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
